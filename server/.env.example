# Copie para .env e preencha. O arquivo .env está no .gitignore.
# Chave da API do Claude (console.anthropic.com). Nunca coloque esta chave no HTML.
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais
JARVIS_MODEL=claude-opus-5        # modelo usado pelo cérebro
JARVIS_EFFORT=low                 # low | medium | high  (low = respostas rápidas para voz)
JARVIS_PORT=8080
JARVIS_NOME_USUARIO=senhor        # como o Jarvis se dirige a você
JARVIS_FALLBACKS=1                # 1 = fallback automático do servidor se o modelo recusar (beta)
