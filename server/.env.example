# Copie para .env e preencha. O arquivo .env está no .gitignore.
# Chave da API do Claude (console.anthropic.com). Nunca coloque esta chave no HTML.
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais
JARVIS_MODEL=claude-sonnet-5      # cérebro do dia a dia (US$ 2/10 por milhão de tokens). Mais barato ainda: claude-haiku-4-5 (1/5). Mais forte: claude-opus-5 (5/25), claude-fable-5-1 (10/50)
JARVIS_MODEL_BRIEFING=            # opcional: modelo só para o resumo matinal, ex.: claude-opus-5. Vazio = mesmo modelo
JARVIS_EFFORT=medium              # low | medium | high | xhigh  (low = mais rápido para voz; high = mais análise)
JARVIS_PORT=8080
JARVIS_NOME_USUARIO=senhor        # como o Jarvis se dirige a você
JARVIS_FALLBACKS=1                # 1 = se o modelo recusar por política, a API reexecuta em outro modelo (beta)
JARVIS_WEB_SEARCH=1               # 1 = ferramenta de busca na web da Anthropic (clima, notícias, fatos)
JARVIS_MCP_PERMITIDOS=            # Fase 4 opção B: servidores MCP que os agentes podem usar no Claude Code, ex.: mcp__revenuecat,mcp__meta-ads

# Fase 7 (opcionais)
# Notificações no celular via Telegram: crie um bot com o @BotFather, pegue o token; mande "oi" ao bot e descubra seu chat_id em
# https://api.telegram.org/bot<TOKEN>/getUpdates (campo "chat":{"id":...}). Com os dois preenchidos, lembretes e alertas chegam no celular.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Voz do JARVIS via ElevenLabs (elevenlabs.io → Profile → API Keys; escolha uma voz britânica na Voice Library e copie o Voice ID).
# Sem estas duas, o painel usa a voz do navegador.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5   # rápido e multilíngue; alternativa com mais qualidade: eleven_multilingual_v2
# Transcrição por Whisper (melhor que o reconhecimento do navegador em ambientes barulhentos e em pt-BR).
#   navegador → padrão, sem custo, só Chrome/Edge
#   openai    → API de áudio da OpenAI (modelo whisper-1); precisa de OPENAI_API_KEY (platform.openai.com)
#   local     → whisper.cpp ou outro comando na sua máquina; precisa de WHISPER_CMD e do ffmpeg instalado
JARVIS_STT=navegador
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# Exemplo whisper.cpp (https://github.com/ggml-org/whisper.cpp): baixe um modelo (ggml-small.bin é um bom começo) e aponte:
# WHISPER_CMD=whisper-cli -m /caminho/ggml-small.bin -l {idioma} -nt -np -f {arquivo}
WHISPER_CMD=
JARVIS_STT_IDIOMA=pt
